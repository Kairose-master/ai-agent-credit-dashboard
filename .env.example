# Neon PostgreSQL connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Better Auth base URL (local dev)
BETTER_AUTH_URL=http://localhost:3000

# Python agent runtime (agent-runtime/, uvicorn runtime.server:app --port 8000)
# In production set this to your Railway URL, e.g. https://xxx.up.railway.app
AGENT_RUNTIME_URL=http://localhost:8000

# BYOK: encrypts users' stored Anthropic API keys at rest (AES-256-GCM).
# Any long random string; generate with `openssl rand -hex 32`. Rotating it
# invalidates stored keys (users re-enter them).
API_KEY_ENCRYPTION_SECRET=
# Set true to REQUIRE every user to bring their own key (public deployments);
# false/absent lets runs fall back to the runtime's ANTHROPIC_API_KEY.
REQUIRE_USER_API_KEY=false

# Shared secret authenticating both directions of Next.js <-> runtime traffic.
# Set the SAME value here (Vercel) and on the runtime (Railway). Generate one
# with e.g. `openssl rand -hex 32`. Leave blank only for local dev.
RUNTIME_SHARED_SECRET=

# Vercel Blob: stores Labor Market job attachments (source material a worker
# agent should act on, e.g. a PDF to summarize). On Vercel this is
# auto-provisioned once a Blob store is attached to the project; for local
# dev, create one at vercel.com/dashboard -> Storage and paste its token.
# Leave blank to disable job attachments (everything else still works).
BLOB_READ_WRITE_TOKEN=

# Used by the agent runtime process (not by Next.js):
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
# RUNTIME_SHARED_SECRET=<same value as above>

# ─── On-chain layer (OPTIONAL — Ethereum Sepolia) ──────────────────────────
# Leave all blank to run off-chain only. See contracts/README.md for the full
# deploy runbook. Once the contracts are deployed, fill these in on Vercel.
SEPOLIA_RPC_URL=
ZERODEV_RPC=                     # ZeroDev v3 RPC (bundler + paymaster) for your project
ORACLE_PRIVATE_KEY=              # EOA that publishes limits + EAS attestations (funded with Sepolia ETH)
AGENT_OWNER_PRIVATE_KEY=         # EOA that owns every agent's Kernel smart account
CREDIT_REGISTRY_ADDRESS=         # from forge deploy
CREDIT_VAULT_ADDRESS=            # from forge deploy
LABOR_MARKET_ADDRESS=            # from forge deploy
VERIFIED_TASK_ESCROW_ADDRESS=    # from forge deploy
MOCK_USDC_ADDRESS=               # from forge deploy
EAS_ADDRESS=0xC2679fBD37d54388Ce493F1DB75320D236e1815e   # EAS on Sepolia (default)
EAS_SCHEMA_UID=                  # register the schema once, then paste its UID here
# Spending caps. IMPORTANT: leave these UNSET for the defaults — do NOT set
# them to an empty value (an empty var once parsed as a $0/day cap in
# production and blocked every withdrawal; empty/zero/garbage now falls
# back to the default, but don't rely on it). These are only the PLATFORM
# DEFAULTS — each account can override its own caps in Worker Console →
# payout settings, bounded by WALLET_CAP_HARD_MAX_USD.
WALLET_MAX_TX_USD=100            # per-transfer cap for agent wallet payments
WALLET_DAILY_CAP_USD=500         # rolling 24h spending cap per agent
WALLET_CAP_HARD_MAX_USD=100000   # absolute ceiling a user-set cap may reach
AUTO_APPROVE_MAX_BOUNTY_USD=50   # graded-pass auto-release ceiling; larger jobs wait for manual approve
REGISTER_HOURLY_MAX_USERS=30     # platform-wide new-account throttle on POST /api/agents/register
MAX_AGENTS_PER_ACCOUNT=20        # per-account agent cap (each agent gets a provisioned wallet)
ADMIN_EMAIL=                     # your login email — superadmin, implicitly holds every permission in the
                                  # access control matrix (/admin/access grants specific permissions to others)
CRON_SECRET=                     # protects GET /api/cron/settle (background settlement heartbeat).
                                  # Set the SAME value as a GitHub Actions repo secret so
                                  # .github/workflows/settle-heartbeat.yml can call it every ~5 min;
                                  # Vercel Cron sends it automatically as a Bearer token.
# ETHERSCAN_API_KEY=             # optional, for contract verification during deploy
