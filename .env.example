# Neon PostgreSQL connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Better Auth base URL (local dev)
BETTER_AUTH_URL=http://localhost:3000

# Python agent runtime (agent-runtime/, uvicorn runtime.server:app --port 8000)
# In production set this to your Railway URL, e.g. https://xxx.up.railway.app
AGENT_RUNTIME_URL=http://localhost:8000

# Shared secret authenticating both directions of Next.js <-> runtime traffic.
# Set the SAME value here (Vercel) and on the runtime (Railway). Generate one
# with e.g. `openssl rand -hex 32`. Leave blank only for local dev.
RUNTIME_SHARED_SECRET=

# Used by the agent runtime process (not by Next.js):
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
# RUNTIME_SHARED_SECRET=<same value as above>
